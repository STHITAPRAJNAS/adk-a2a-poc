# ---------------------------------------------------------------------------
# adk-a2a-poc — copy to `.env` and fill in.
#   cp .env.example .env
# ADK walks up from each agent package to the repo root looking for `.env`,
# so a single file here is picked up by BOTH servers.
# ---------------------------------------------------------------------------

# --- Gemini credentials -----------------------------------------------------
# Supplied at run time. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Use the Gemini Developer API (AI Studio key) rather than Vertex AI / enterprise
# mode. ADK 2.8 reads GOOGLE_GENAI_USE_ENTERPRISE; the older
# GOOGLE_GENAI_USE_VERTEXAI still works but warns. FALSE is also the default.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# --- Models -----------------------------------------------------------------
ORCHESTRATOR_MODEL=gemini-2.5-flash
DEPLOYMENT_AGENT_MODEL=gemini-2.5-flash

# --- Wiring -----------------------------------------------------------------
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000

REMOTE_AGENT_HOST=127.0.0.1
REMOTE_AGENT_PORT=8001

# Where the orchestrator fetches the remote agent's A2A Agent Card from.
# Must share an origin with the `url` inside remote_agents/deployment_agent/agent.json.
DEPLOYMENT_AGENT_CARD_URL=http://127.0.0.1:8001/a2a/deployment_agent/.well-known/agent-card.json

# --- Demo knobs -------------------------------------------------------------
# Wall-clock seconds the simulated compliance scan blocks for. This is what
# keeps the A2A task in TASK_STATE_WORKING long enough to watch it stream.
COMPLIANCE_SCAN_SECONDS=12
# Wall-clock seconds the simulated deployment job runs in the background.
DEPLOYMENT_JOB_SECONDS=25

# Run both agents on a deterministic scripted model instead of Gemini, so the
# A2A mechanics can be exercised with no API key at all. Set to 1/true to enable.
POC_FAKE_LLM=0

# Silence ADK's "A2A support is experimental" banner.
ADK_SUPPRESS_A2A_EXPERIMENTAL_FEATURE_WARNINGS=1
