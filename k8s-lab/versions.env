# ---------------------------------------------------------------------------
# Every pinned version in this lab lives here. Nothing else hardcodes one.
#
# Checked against upstream on 2026-09-11. They will drift — `make versions`
# prints what is current so you can bump these deliberately rather than
# discover a mismatch three labs later.
# ---------------------------------------------------------------------------

# Kubernetes, via the kind node image. kind v0.30+ defaults to this.
KIND_NODE_IMAGE=kindest/node:v1.36.1
KUBERNETES_MINOR=1.36

# Service mesh. Ambient mode has been GA since 1.24; this lab uses ambient,
# not sidecars. 1.31.0 released 2026-08-31.
ISTIO_VERSION=1.31.0

# Gateway API CRDs. Istio and Envoy Gateway both consume these, so they are
# installed once, standalone, rather than letting either chart own them.
GATEWAY_API_VERSION=v1.4.0
GATEWAY_API_CHANNEL=standard

# North-south HTTP gateway (Gateway API implementation). v1.9.1: 2026-08-28.
ENVOY_GATEWAY_VERSION=v1.9.1

# LLM egress gateway. Note: "Envoy AI Gateway" was renamed **Agent Router**
# when it moved to the Agentic AI Foundation. The CRDs, API group
# (aigateway.envoyproxy.io), Helm charts, container images, the `aigw` CLI and
# the envoy-ai-gateway-system namespace were all deliberately left unchanged,
# so older docs still apply.
AI_GATEWAY_VERSION=v1.0.0

# A2A / MCP-aware gateway. This is the one that actually understands the A2A
# protocol; see labs/60-agentgateway.
AGENTGATEWAY_VERSION=v1.4.1

# Local registry kind pulls agent images from.
LOCAL_REGISTRY_PORT=5001
